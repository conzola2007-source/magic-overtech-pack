			x: 4.0d
			y: 1.0d
		}
		{
			dependencies: ["1A20500000000002"]
			description: [
				"Put any spell into any spell book."
				"Use the Inscription Table with a spell scroll and your spell book. Once the spell is stored in the book, click the task in this quest with the book in your inventory or spell book slot."
